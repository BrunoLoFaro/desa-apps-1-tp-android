<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir tokens de sesión del backup a Google Cloud -->
        <exclude domain="sharedpref" path="auth_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Excluir tokens de sesión de la transferencia entre dispositivos -->
        <exclude domain="sharedpref" path="auth_session.xml"/>
    </device-transfer>
</data-extraction-rules>
