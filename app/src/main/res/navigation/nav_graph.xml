<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.myapplication.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_loginFragment_to_classicRegisterFragment"
            app:destination="@id/classicRegisterFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_biometricEnrollFragment"
            app:destination="@id/biometricEnrollFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordRequestFragment"
            app:destination="@id/forgotPasswordRequestFragment" />
    </fragment>

    <!-- Pantalla de entrada de email para OTP login -->
    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.myapplication.ui.auth.SignupFragment"
        android:label="Ingresar con código"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signupFragment_to_otpSignupCodeFragment"
            app:destination="@id/otpSignupCodeFragment" />
    </fragment>

    <!-- Pantalla de verificación OTP (registro y login OTP) -->
    <fragment
        android:id="@+id/otpSignupCodeFragment"
        android:name="com.example.myapplication.ui.auth.OtpSignupCodeFragment"
        android:label="Verificar identidad"
        tools:layout="@layout/fragment_otp_signup_code">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="source"
            app:argType="string"
            android:defaultValue="registration" />
        <action
            android:id="@+id/action_otpSignupCodeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_otpSignupCodeFragment_to_biometricEnrollFragment"
            app:destination="@id/biometricEnrollFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- OtpSignupCompleteFragment: mantenido para compatibilidad de compilación, ya no se navega a él -->
    <fragment
        android:id="@+id/otpSignupCompleteFragment"
        android:name="com.example.myapplication.ui.auth.OtpSignupCompleteFragment"
        android:label="Complete Signup"
        tools:layout="@layout/fragment_otp_signup_complete">
        <argument
            android:name="email"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="code"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_otpSignupCompleteFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Pantalla de registro (sin DNI, con teléfono opcional) -->
    <fragment
        android:id="@+id/classicRegisterFragment"
        android:name="com.example.myapplication.ui.auth.ClassicRegisterFragment"
        android:label="Crear cuenta"
        tools:layout="@layout/fragment_classic_register">
        <action
            android:id="@+id/action_classicRegisterFragment_to_otpSignupCodeFragment"
            app:destination="@id/otpSignupCodeFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordRequestFragment"
        android:name="com.example.myapplication.ui.auth.ForgotPasswordRequestFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password_request">
        <action
            android:id="@+id/action_forgotPasswordRequestFragment_to_forgotPasswordCodeFragment"
            app:destination="@id/forgotPasswordCodeFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordCodeFragment"
        android:name="com.example.myapplication.ui.auth.ForgotPasswordCodeFragment"
        android:label="Verify Code"
        tools:layout="@layout/fragment_forgot_password_code">
        <argument
            android:name="email"
            app:argType="string" />
        <action
            android:id="@+id/action_forgotPasswordCodeFragment_to_forgotPasswordNewPasswordFragment"
            app:destination="@id/forgotPasswordNewPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordNewPasswordFragment"
        android:name="com.example.myapplication.ui.auth.ForgotPasswordNewPasswordFragment"
        android:label="New Password"
        tools:layout="@layout/fragment_forgot_password_new_password">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="code"
            app:argType="string" />
        <action
            android:id="@+id/action_forgotPasswordNewPasswordFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_forgotPasswordNewPasswordFragment_to_biometricEnrollFragment"
            app:destination="@id/biometricEnrollFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/biometricEnrollFragment"
        android:name="com.example.myapplication.ui.auth.BiometricEnrollFragment"
        android:label="Biometric Enroll"
        tools:layout="@layout/fragment_biometric_enroll">
        <argument
            android:name="origin"
            app:argType="string"
            android:defaultValue="auth" />
        <action
            android:id="@+id/action_biometricEnrollFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/biometricEnrollFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.myapplication.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_bookingsFragment"
            app:destination="@id/bookingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingsFragment"
        android:name="com.example.myapplication.ui.bookings.BookingsFragment"
        android:label="Bookings"
        tools:layout="@layout/fragment_bookings">
        <action
            android:id="@+id/action_bookingsFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_bookingsFragment_to_voucherFragment"
            app:destination="@id/voucherFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.myapplication.ui.profile.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_profileFragment_to_bookingsFragment"
            app:destination="@id/bookingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_biometricEnrollFragment"
            app:destination="@id/biometricEnrollFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.myapplication.ui.explore.ExploreFragment"
        android:label="Explore" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.myapplication.ui.favorites.FavoritesFragment"
        android:label="@string/nav_favorites"
        tools:layout="@layout/fragment_favorites" />

    <fragment
        android:id="@+id/newsFragment"
        android:name="com.example.myapplication.ui.home.NewsFragment"
        android:label="Noticias"
        tools:layout="@layout/fragment_news">
        <action
            android:id="@+id/action_newsFragment_to_newsDetailFragment"
            app:destination="@id/newsDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/newsDetailFragment"
        android:name="com.example.myapplication.ui.home.NewsDetailFragment"
        android:label="Detalle de Noticia"
        tools:layout="@layout/fragment_news_detail">
        <argument
            android:name="news_id"
            app:argType="long" />
        <argument
            android:name="related_activity_id"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

      <fragment
          android:id="@+id/detailFragment"
          android:name="com.example.myapplication.ui.home.DetailFragment"
          android:label="Detail"
          tools:layout="@layout/fragment_detail">
          <argument
              android:name="activity_data"
              app:argType="com.example.myapplication.data.model.TourActivity" />
          <argument
              android:name="activity_id"
              app:argType="long"
              android:defaultValue="-1L" />
          <argument
              android:name="from_booking"
              app:argType="boolean"
              android:defaultValue="false" />
          <action
              android:id="@+id/action_detailFragment_to_voucherFragment"
              app:destination="@id/voucherFragment" />
      </fragment>

    <fragment
        android:id="@+id/voucherFragment"
        android:name="com.example.myapplication.ui.bookings.VoucherFragment"
        android:label="Voucher"
        tools:layout="@layout/fragment_voucher">
        <argument
            android:name="bookingId"
            app:argType="long" />
        <action
            android:id="@+id/action_voucherFragment_to_checkInScanFragment"
            app:destination="@id/checkInScanFragment" />
    </fragment>

    <!-- Check-in por QR (Feature 11) -->
    <fragment
        android:id="@+id/checkInScanFragment"
        android:name="com.example.myapplication.ui.checkin.CheckInScanFragment"
        android:label="@string/checkin_title"
        tools:layout="@layout/fragment_check_in_scan">
        <argument
            android:name="voucherCode"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="sessionId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="activityName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>
