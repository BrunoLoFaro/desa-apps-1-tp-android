<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.myapplication.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordRequestFragment"
            app:destination="@id/forgotPasswordRequestFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.myapplication.ui.auth.SignupFragment"
        android:label="Signup"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signupFragment_to_otpSignupCodeFragment"
            app:destination="@id/otpSignupCodeFragment" />
        <action
            android:id="@+id/action_signupFragment_to_classicRegisterFragment"
            app:destination="@id/classicRegisterFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpSignupCodeFragment"
        android:name="com.example.myapplication.ui.auth.OtpSignupCodeFragment"
        android:label="Verify OTP"
        tools:layout="@layout/fragment_otp_signup_code">
        <argument
            android:name="email"
            app:argType="string" />
        <action
            android:id="@+id/action_otpSignupCodeFragment_to_otpSignupCompleteFragment"
            app:destination="@id/otpSignupCompleteFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpSignupCompleteFragment"
        android:name="com.example.myapplication.ui.auth.OtpSignupCompleteFragment"
        android:label="Complete Signup"
        tools:layout="@layout/fragment_otp_signup_complete">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="code"
            app:argType="string" />
        <action
            android:id="@+id/action_otpSignupCompleteFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/classicRegisterFragment"
        android:name="com.example.myapplication.ui.auth.ClassicRegisterFragment"
        android:label="Classic Register"
        tools:layout="@layout/fragment_classic_register">
        <action
            android:id="@+id/action_classicRegisterFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordRequestFragment"
        android:name="com.example.myapplication.ui.auth.ForgotPasswordRequestFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password_request">
        <action
            android:id="@+id/action_forgotPasswordRequestFragment_to_forgotPasswordCodeFragment"
            app:destination="@id/forgotPasswordCodeFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordCodeFragment"
        android:name="com.example.myapplication.ui.auth.ForgotPasswordCodeFragment"
        android:label="Verify Code"
        tools:layout="@layout/fragment_forgot_password_code">
        <argument
            android:name="email"
            app:argType="string" />
        <action
            android:id="@+id/action_forgotPasswordCodeFragment_to_forgotPasswordNewPasswordFragment"
            app:destination="@id/forgotPasswordNewPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordNewPasswordFragment"
        android:name="com.example.myapplication.ui.auth.ForgotPasswordNewPasswordFragment"
        android:label="New Password"
        tools:layout="@layout/fragment_forgot_password_new_password">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="code"
            app:argType="string" />
        <action
            android:id="@+id/action_forgotPasswordNewPasswordFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.myapplication.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_bookingsFragment"
            app:destination="@id/bookingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingsFragment"
        android:name="com.example.myapplication.ui.bookings.BookingsFragment"
        android:label="Bookings"
        tools:layout="@layout/fragment_bookings" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.myapplication.ui.profile.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.myapplication.ui.home.DetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="activity_data"
            app:argType="com.example.myapplication.data.model.TourActivity" />
    </fragment>

</navigation>
