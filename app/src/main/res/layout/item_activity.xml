<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_content_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/activity_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/favorite_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="16dp"
                android:contentDescription="@string/favorite_desc"
                android:padding="6dp"
                android:src="@drawable/ic_favorite_border"
                android:background="@drawable/bg_heart_circle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/chips_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/activity_image">
                <TextView android:id="@+id/chip_sold_out" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
                <TextView android:id="@+id/chip_slots_available" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
                <TextView android:id="@+id/chip_new_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/category_rating_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/chips_container">
                <TextView
                    android:id="@+id/activity_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:lines="1"
                    android:ellipsize="end" />
                <LinearLayout
                    android:id="@+id/rating_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@android:drawable/btn_star_big_on" app:tint="#FFC107" />
                    <TextView android:id="@+id/activity_rating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/activity_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.XploreNow.H2"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lines="2"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/category_rating_row" />

            <TextView
                android:id="@+id/activity_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="18sp"
                android:lines="1"
                android:ellipsize="end"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                app:drawableTint="?attr/colorPrimary"
                app:layout_constraintTop_toBottomOf="@id/activity_name" />

            <TextView
                android:id="@+id/activity_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="17sp"
                android:lines="1"
                android:ellipsize="end"
                app:drawableStartCompat="@android:drawable/ic_menu_recent_history"
                app:drawableTint="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/activity_destination" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/footer_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/activity_duration"
                app:layout_constraintBottom_toTopOf="@id/detailed_info_container">

                <LinearLayout
                    android:id="@+id/price_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView android:id="@+id/activity_slots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorError" android:textSize="14sp" android:textStyle="bold" android:lines="1" />
                    <TextView android:id="@+id/original_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:visibility="invisible" android:lines="1" />
                    <TextView android:id="@+id/activity_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/colorOnSurface" android:textSize="24sp" android:textStyle="bold" android:lines="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/discount_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/discount_badge_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/detailed_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/footer_content"
                app:layout_constraintBottom_toBottomOf="parent">
                <TextView android:id="@+id/activity_description" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/activity_language" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/activity_guide" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/activity_meeting_point" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/activity_includes" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/activity_cancellation" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
