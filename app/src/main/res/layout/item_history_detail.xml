<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Full-bleed image (same structure as item_activity) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp">

        <ImageView
            android:id="@+id/hist_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_image_scrim_top" />

    </FrameLayout>

    <!-- White content card overlapping image bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_detail_sheet"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Status chip centered -->
        <com.google.android.material.chip.Chip
            android:id="@+id/hist_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clickable="false"
            android:focusable="false"
            android:text="✓ ACTIVIDAD FINALIZADA"
            android:textAllCaps="true"
            android:textColor="@color/success"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/success_container"
            app:chipStrokeWidth="0dp"
            tools:ignore="ClickableViewAccessibility" />

        <!-- Title -->
        <TextView
            android:id="@+id/hist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Circuito Chico en bici" />

        <!-- "Actividad completada" chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/hist_completed_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:clickable="false"
            android:focusable="false"
            android:text="Actividad completada"
            android:textColor="@color/success"
            android:textSize="13sp"
            app:chipBackgroundColor="@color/success_container"
            app:chipIcon="@drawable/ic_check"
            app:chipIconTint="@color/success"
            app:chipIconVisible="true"
            app:chipStrokeWidth="0dp"
            tools:ignore="ClickableViewAccessibility" />

        <!-- Date -->
        <TextView
            android:id="@+id/hist_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:drawableTint="?attr/colorTertiary"
            tools:text="20 de abril de 2024" />

        <!-- Duration -->
        <TextView
            android:id="@+id/hist_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_clock"
            app:drawableTint="?attr/colorTertiary"
            tools:text="Duración: 4 horas" />

        <!-- Price -->
        <TextView
            android:id="@+id/hist_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_money"
            app:drawableTint="?attr/colorTertiary"
            tools:text="$18,000 por persona" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Resumen title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:text="Resumen"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Resumen text -->
        <TextView
            android:id="@+id/hist_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            tools:text="Pedaleaste por el famoso Circuito Chico..." />

        <!-- Tu reseña title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:text="Tu reseña"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Review card (shown when review exists) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hist_review_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/hist_review_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="Increíble experiencia, muy buenos paisajes y guía atenta en todo momento. ¡Recomendado!" />

                <RatingBar
                    android:id="@+id/hist_review_rating"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:stepSize="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hist_edit_review_btn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="Editar reseña"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- "Sin reseña" placeholder (shown when no review exists) -->
        <TextView
            android:id="@+id/hist_no_review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:text="Aún no dejaste una reseña."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Gallery button (visible if activity has gallery) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hist_gallery_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/md_theme_primaryContainer"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_camera"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Ver galería de fotos"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
