<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Date/time + spots (left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/session_datetime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.XploreNow.H2"
                android:textColor="?attr/colorOnBackground"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="2026-04-01 10:00" />

            <TextView
                android:id="@+id/session_spots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorTertiary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="¡Solo quedan 10 cupos!" />

        </LinearLayout>

        <!-- Price (right) -->
        <TextView
            android:id="@+id/session_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:visibility="gone"
            android:textColor="?attr/colorTertiary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="$100.00" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
