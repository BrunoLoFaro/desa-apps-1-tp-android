<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XploreNow"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XploreNow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:label="@string/action_register"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".ClassicRegisterActivity"
            android:exported="false"
            android:label="@string/classic_register_title"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".ForgotPasswordRequestActivity"
            android:exported="false"
            android:label="@string/password_reset_title"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".ForgotPasswordCodeActivity"
            android:exported="false"
            android:label="@string/action_verify_code"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".ForgotPasswordNewPasswordActivity"
            android:exported="false"
            android:label="@string/password_reset_new_password_title"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".OtpSignupCodeActivity"
            android:exported="false"
            android:label="@string/action_verify_code"
            android:theme="@style/Theme.XploreNow" />
        <activity
            android:name=".OtpSignupCompleteActivity"
            android:exported="false"
            android:label="@string/action_complete_registration"
            android:theme="@style/Theme.XploreNow" />
    </application>

</manifest>
